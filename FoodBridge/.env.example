# Copy to .env (never commit .env). Placeholders only.
DB_URL=jdbc:mysql://localhost:3306/foodbridge?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=foodbridge
DB_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root
# First administrator (optional, min 10 chars). Leave empty to create none.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Demo data: true ONLY on your own machine
SEED_ENABLED=false
SEED_DEMO_PASSWORD=choose_a_demo_password
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
MAIL_ENABLED=false
